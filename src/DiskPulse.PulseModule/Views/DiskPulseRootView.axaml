<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DiskPulse.PulseModule.Views.DiskPulseRootView"
             Background="{StaticResource WindowBackground}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DiskPulse.PulseModule/Styles/DiskPulseColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://DiskPulse.PulseModule/Styles/DiskPulseTheme.axaml" />
    </UserControl.Styles>

    <Grid ColumnDefinitions="228,*">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="14,14,14,16">
                <StackPanel Grid.Row="0">
                    <TextBlock Text="ОБЗОР" Foreground="#5A667E" FontSize="10.5" FontWeight="SemiBold" Margin="12,6,0,8" />

                    <Button x:Name="HomeNavButton" Classes="nav-btn active" Click="HomeNavigation_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="15" Height="15" Foreground="{Binding $parent[Button].Foreground}"
                                      Data="M 1,7.5 L 8,1.5 L 15,7.5 L 15,14.5 L 10,14.5 L 10,10 L 6,10 L 6,14.5 L 1,14.5 Z" />
                            <TextBlock Text="Главная" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ProgramsNavButton" Classes="nav-btn" Click="ProgramsNavigation_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="15" Height="15" Foreground="{Binding $parent[Button].Foreground}"
                                      Data="M 1,1 H 6 V 6 H 1 Z M 9,1 H 14 V 6 H 9 Z M 1,9 H 6 V 14 H 1 Z M 9,9 H 14 V 14 H 9 Z" />
                            <TextBlock Text="Программы" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="HistoryNavButton" Classes="nav-btn" Click="HistoryNavigation_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="15" Height="15" Foreground="{Binding $parent[Button].Foreground}"
                                      Data="M 8,1 A 7,7 0 1 1 1,8 A 7,7 0 0 1 8,1 M 8,4.5 V 8 L 11,10.5" />
                            <TextBlock Text="История" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="ПРИЛОЖЕНИЕ" Foreground="#5A667E" FontSize="10.5" FontWeight="SemiBold" Margin="12,20,0,8" />

                    <Button x:Name="SettingsNavButton" Classes="nav-btn" Click="SettingsNavigation_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="15" Height="15" Foreground="{Binding $parent[Button].Foreground}"
                                      Data="M 8,5.5 A 2.5,2.5 0 1 1 8,10.5 A 2.5,2.5 0 0 1 8,5.5 M 8,1.5 L 9.2,3.1 L 11.2,2.8 L 11.8,4.8 L 13.8,5.5 L 13.2,7.5 L 14.5,8.9 L 13.2,10.3 L 13.8,12.3 L 11.8,13 L 11.2,15 L 9.2,14.7 L 8,16.3 L 6.8,14.7 L 4.8,15 L 4.2,13 L 2.2,12.3 L 2.8,10.3 L 1.5,8.9 L 2.8,7.5 L 2.2,5.5 L 4.2,4.8 L 4.8,2.8 L 6.8,3.1 Z" />
                            <TextBlock Text="Настройки" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="HelpNavButton" Classes="nav-btn" Click="HelpNavigation_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="15" Height="15" Foreground="{Binding $parent[Button].Foreground}"
                                      Data="M 8,1 A 7,7 0 1 1 1,8 A 7,7 0 0 1 8,1 M 6.2,5.8 A 1.8,1.8 0 0 1 9.6,6.6 C 9.6,8 8,8.2 8,9.8 M 8,12 V 12.5" />
                            <TextBlock Text="Помощь" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Storage Card -->
                <Border Grid.Row="2" Classes="card" CornerRadius="12" Padding="14,12" VerticalAlignment="Bottom">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Ваш компьютер" Foreground="{StaticResource Ink}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#163326" CornerRadius="5" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="Активен" Foreground="{StaticResource AccentGreen}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="SidebarDriveSubtext" Text="Защищён и готов к очистке" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="FreeSpaceProgress" Minimum="0" Maximum="100" Value="0" Height="4" Margin="0,10,0,0" Foreground="{StaticResource Purple}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Workspace View Area -->
        <Grid Grid.Column="1" Margin="28,16,30,18">
            <Grid x:Name="HomeView" RowDefinitions="Auto,Auto,Auto,*">
                <!-- Greeting Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="WelcomeText" Foreground="{StaticResource Ink}" FontSize="23" FontWeight="Bold" />
                        <TextBlock Text="Проверим состояние дисков, кэшей и установленных программ" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="38" Height="38" CornerRadius="19" Background="{StaticResource PurpleLight}" BorderBrush="#3B346E" BorderThickness="1">
                        <TextBlock x:Name="UserInitialText" Foreground="{StaticResource Purple}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Status & Disk Chart Card -->
                <Border Grid.Row="1" Classes="card" Padding="22,18" Margin="0,0,0,14">
                    <Grid ColumnDefinitions="*,420">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="СОСТОЯНИЕ СИСТЕМЫ" Foreground="{StaticResource Muted}" FontSize="10.5" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Text="Всё чисто" Foreground="{StaticResource Ink}" FontSize="23" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock x:Name="StatusDetails" Text="Подсчитываем занятое место по выбранным томам..." Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                            <ProgressBar x:Name="ScanProgressBar" Height="4" Width="280" HorizontalAlignment="Left" Margin="0,10,0,0" IsIndeterminate="True" IsVisible="False" Foreground="{StaticResource Purple}" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Spacing="10">
                                <Button x:Name="ScanButton" Content="Начать проверку" Classes="primary-btn" Click="ScanButton_Click" />
                                <Button x:Name="DriveButton" Content="Диски..." Classes="secondary-btn" Click="DriveButton_Click" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Classes="inner-card" Padding="16,14">
                            <Grid ColumnDefinitions="145,*">
                                <Grid Grid.Column="0" Width="145" Height="145" VerticalAlignment="Center">
                                    <Canvas x:Name="DiskUsageRing" Width="145" Height="145">
                                        <Ellipse Width="145" Height="145" Stroke="{StaticResource Line}" StrokeThickness="12" />
                                    </Canvas>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="FreeSpaceText" Text="—" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="свободно" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="DiskLegendPanel" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Summary Cards -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,0,0,14">
                    <Border Grid.Column="0" Classes="card" Padding="18,14" Margin="0,0,7,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Temp и кэш пользователя" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" />
                                <Border Width="8" Height="8" CornerRadius="4" Background="#38B2AC" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="UserTempValue" Text="—" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
                            <TextBlock x:Name="UserTempSubtitle" Text="Ожидает проверки" Foreground="#38B2AC" FontSize="11.5" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card" Padding="18,14" Margin="7,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Системный Temp" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" />
                                <Border Width="8" Height="8" CornerRadius="4" Background="#8576FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="WindowsTempValue" Text="—" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
                            <TextBlock x:Name="WindowsTempSubtitle" Text="Ожидает проверки" Foreground="#8576FF" FontSize="11.5" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="card" Padding="18,14" Margin="7,0,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Корзина" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" />
                                <Border Width="8" Height="8" CornerRadius="4" Background="#EF8E5B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="RecycleBinValue" Text="—" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
                            <TextBlock x:Name="RecycleBinSubtitle" Text="Ожидает проверки" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Action Card and Recent Activity -->
                <Grid Grid.Row="3" ColumnDefinitions="1.15*,0.85*">
                    <Border Grid.Column="0" Classes="card" Padding="20,16" Margin="0,0,7,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Что можно очистить" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Выберите категории для следующей очистки" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,10" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="4">
                                <CheckBox x:Name="UserTempCheckBox" Content="Временные файлы пользователя" IsChecked="True" />
                                <CheckBox x:Name="WindowsTempCheckBox" Content="Системные временные файлы" IsChecked="False" />
                                <CheckBox x:Name="RecycleBinCheckBox" Content="Содержимое корзины" IsChecked="False" />
                                <CheckBox x:Name="DevCachesCheckBox" Content="Кэши разработки (NuGet, npm, pip)" IsChecked="False" />
                            </StackPanel>
                            <Button Grid.Row="2" x:Name="CleanButton" Content="Очистить выбранное" Classes="primary-btn" HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="False" Click="CleanButton_Click" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="card" Padding="20,16" Margin="7,0,0,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Последняя активность" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="ActivityText" Text="Проверка ещё не выполнялась" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,10" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ActivityResultText" Text="Запустите сканирование" Foreground="{StaticResource AccentGreen}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock x:Name="ActivitySizeText" Text="Данные не удаляются без подтверждения" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Row="2" x:Name="DetailsButton" Content="Показать детали" Classes="secondary-btn" HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="False" Click="DetailsButton_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ContentControl x:Name="PageHost" IsVisible="False" />
        </Grid>
    </Grid>
</UserControl>
