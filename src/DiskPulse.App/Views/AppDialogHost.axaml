<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cleaner.App.Views.AppDialogHost"
             IsVisible="False">
    <Grid Background="#A606080E">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="460" MaxWidth="520"
                Background="#121725" BorderBrush="#252E42" BorderThickness="1"
                CornerRadius="16" Padding="24">
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="#F4F6FB" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Foreground="#C4CDDF" FontSize="13.5" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="10">
                    <Button x:Name="CancelButton" Content="Отмена"
                            Background="#161C2C" Foreground="#F4F6FB" BorderBrush="#252E42" BorderThickness="1"
                            Padding="16,9" CornerRadius="10" FontSize="13" FontWeight="Medium"
                            Click="CancelButton_Click" />
                    <Button x:Name="ConfirmButton" Content="ОК"
                            Background="#7C6BFF" Foreground="White" BorderThickness="0"
                            Padding="18,9" CornerRadius="10" FontSize="13" FontWeight="SemiBold"
                            Click="ConfirmButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
